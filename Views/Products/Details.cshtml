@model StyleSphere.Models.ViewModel.ProductViewModel
@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .product-details-container {
            max-width: 950px;
            margin: 48px auto 0 auto;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.09);
            padding: 40px 32px 32px 32px;
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            align-items: flex-start;
        }

        .product-image-section {
            flex: 1 1 340px;
            min-width: 320px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .product-image-section img {
                width: 100%;
                max-width: 340px;
                border-radius: 12px;
                box-shadow: 0 4px 24px rgba(255,82,59,0.10);
                background: #fafafa;
                object-fit: cover;
                transition: transform 0.3s;
            }

                .product-image-section img:hover {
                    transform: scale(1.04) rotate(-1deg);
                    box-shadow: 0 8px 32px rgba(255,82,59,0.18);
                }

        .product-info-section {
            flex: 2 1 400px;
            min-width: 320px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .product-title {
            font-size: 2.2rem;
            font-weight: 700;
            color: #222;
            margin-bottom: 8px;
        }

        .product-rating {
            margin-bottom: 10px;
        }

            .product-rating .fa {
                color: orangered;
                font-size: 1.2rem;
            }

        .product-price {
            font-size: 1.5rem;
            color: #ff5e42;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-description {
            color: #444;
            font-size: 1.08rem;
            line-height: 1.7;
            margin-bottom: 18px;
        }

        .add-to-cart-btn {
            display: inline-block;
            background: #ff5e42;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 12px 36px;
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(255,82,59,0.10);
            transition: background 0.2s, transform 0.2s;
        }

            .add-to-cart-btn:hover {
                background: #d8432b;
                transform: scale(1.04);
            }
        @@media (max-width: 900px) {
            .product-details-container

        {
            flex-direction: column;
            padding: 24px 8px;
        }

        .product-image-section, .product-info-section {
            min-width: 0;
        }

        }
    </style>
}

<div class="product-details-container">
    <div class="product-image-section">
        <img src="@Model?.Image" alt="@Model?.Name" />
    </div>
    <div class="product-info-section">
        <div class="product-title">@Model?.Name</div>
        <div class="product-rating">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= (Model?.Rating ?? 0))
                {
                    <i class="fa fa-star"></i>
                }
                else
                {
                    <i class="fa fa-star-o"></i>
                }
            }
            <span style="margin-left:8px; color:#888; font-size:1rem;">
                @((Model?.Rating ?? 0).ToString("0.0"))/5
            </span>
        </div>
        <div class="product-price">₹@Model?.Price.00</div>
        <div class="product-description">
            @Model?.Description
        </div>
        <form asp-action="AddToCart" asp-controller="Cart" method="post" style="margin-top:18px;">
            <input type="hidden" name="productId" value="@Model?.Id" />
            <button type="submit" class="add-to-cart-btn">
                <i class="fa fa-shopping-cart"></i> Add to Cart
            </button>
        </form>
    </div>
</div>