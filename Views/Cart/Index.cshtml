@model IEnumerable<StyleSphere.Models.CartEntity.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    Layout = "_Layout";
}

@if (TempData["CartError"] != null) 
{
    <div class="alert alert-danger">@TempData["CartError"]</div>    
}


<table>
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@item.Product?.buyimage" /></td>
                <td>@item.Quantity</td>
                <td>@item.Product?.price</td>
                <td style="right:0;">@((item.Product?.price ?? 0) * item.Quantity)</td>
                <td>
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="cartItemId" value="@item.Id"/>
                        <button type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>