@model IEnumerable<StyleSphere.Models.CartEntity.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    Layout = "_Layout";
}
<h2>Your Cart</h2>
<table>
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product?.name</td>
                <td>@item.Quantity</td>
                <td>@item.Product?.price</td>
                <td>@((item.Product?.price ?? 0) * item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>