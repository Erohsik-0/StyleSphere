@using StyleSphere.Models.ViewModel
@model dynamic
@{
    ViewData["Title"] = "Account";
    Layout = "_Layout";
}
<div class="account-page">
    <div class="container">
        <div class="row">
            <div class="col-2">
                <img src="~/images/base.png" />
            </div>
            <div class="col-2">
                <div class="form-container">
                    <div class="form-btn">

                        <p> <a asp-controller="Account" asp-action="Login">Login</a></p>
                        <p> <a asp-controller="Account" asp-action="Register">Register</a></p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
